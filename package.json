{
  "name": "job-agent",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "db:up": "docker compose up -d --wait db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "ingest": "tsx --env-file=.env src/scripts/ingest.ts",
    "typecheck": "tsc -p .",
    "validate:cv": "tsx src/scripts/validateCv.ts",
    "gmail:auth": "tsx src/scripts/gmailAuth.ts",
    "score": "tsx --env-file=.env src/scripts/score.ts",
    "digest": "tsx --env-file=.env src/scripts/digest.ts",
    "decide": "tsx --env-file=.env src/scripts/decide.ts",
    "pipeline": "npm run ingest && npm run enrich && npm run score && npm run digest",
    "llm:models": "tsx --env-file=.env src/scripts/llmModels.ts",
    "cv:base": "tsx --env-file=.env src/scripts/renderBaseCv.ts",
    "tailor": "tsx --env-file=.env src/scripts/tailor.ts",
    "track": "tsx --env-file=.env src/scripts/track.ts",
    "gmail:check": "tsx --env-file=.env src/scripts/gmailCheck.ts",
    "refilter": "tsx --env-file=.env src/scripts/refilter.ts",
    "simulate": "tsx --env-file=.env src/scripts/simulate.ts",
    "describe": "tsx --env-file=.env src/scripts/describe.ts",
    "enrich": "tsx --env-file=.env src/scripts/enrich.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@google-cloud/local-auth": "^3.0.1",
    "drizzle-orm": "^0.45.3",
    "googleapis": "^182.0.0",
    "node-html-parser": "^9.0.4",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
