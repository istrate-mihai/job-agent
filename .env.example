# Run `npm run setup` instead of editing by hand: it fills these in.
# Database: embedded (built-in PostgreSQL, no Docker) | docker | external
DB_MODE=
POSTGRES_USER=jobagent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobagent
DATABASE_URL=postgres://jobagent:change-me@127.0.0.1:5432/jobagent
# LLM providers: fill any subset; routes without a key are skipped
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
